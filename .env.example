# Auth.js session signing secret. Generate with: bunx auth secret
AUTH_SECRET=

# Server-only TMDB v4 read access token. Never prefix this with NEXT_PUBLIC_.
TMDB_READ_ACCESS_TOKEN=

# Optional client-safe overrides.
# NEXT_PUBLIC_TMDB_PROXY_BASE=/api/tmdb
# NEXT_PUBLIC_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
